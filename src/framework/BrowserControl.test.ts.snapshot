exports[`scripted browser: optional placeholder update without a placeholder 1`] = `
[
	{
		"src": "WebRunner",
		"msg": "Scripted browser HTTP request",
		"http": "request",
		"request_uri": "BASE/callback",
		"request_method": "GET",
		"browser": "goToUrl"
