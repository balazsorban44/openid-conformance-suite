exports[`scripted browser: POST navigation goes through a form 1`] = `
[
	{
		"src": "WebRunner",
		"msg": "Scripted browser HTTP request",
		"http": "request",
		"request_uri": "BASE/post",
		"parameters": "a=1&b=x+y",
		"request_method": "POST",
		"browser": "goToUrl"
	},
	{
		"src": "WebRunner",
		"msg": "Scripted browser HTTP response",
		"http": "response",
		"response_status_code": 200,
		"response_status_text": "200-",
		"response_content_type": "text/html; charset=utf-8",
		"response_content": "[html]"
	},
	{
		"src": "WebRunner",
		"msg": "Waiting",
		"url": "BASE/post",
		"browser": "wait",
		"task": "Check",
		"element_type": "id",
		"target": "posted",
		"seconds": 5,
		"result": "INFO",
		"regexp": "a=1&b=x\\\\+y",
		"action": null
	},
	{
		"src": "WebRunner",
		"msg": "Completed processing of webpage",
		"match": "*",
		"url": "BASE/post",
		"browser": "complete",
		"task": "Check",
		"result": "INFO",
		"response_status_code": 200,
		"response_status_text": "200-"
	}
]
`;

exports[`scripted browser: a TypeScript hook drives the page 1`] = `
[
	{
		"src": "Cond",
		"msg": "p",
		"upload": "ph",
		"page_source": "[html]",
		"content_type": "text/html; charset=utf-8",
		"matched_regexp": null,
		"img": "[png]"
	},
	{
		"src": "WebRunner",
		"msg": "Scripted browser HTTP request",
		"http": "request",
		"request_uri": "BASE/start",
		"request_method": "GET",
		"browser": "goToUrl"
	},
	{
		"src": "WebRunner",
		"msg": "Scripted browser HTTP response",
		"http": "response",
		"response_status_code": 200,
		"response_status_text": "200-",
		"response_content_type": "text/html; charset=utf-8",
		"response_content": "[html]"
	},
	{
		"src": "WebRunner",
		"msg": "filled",
		"browser": "hook",
		"field": "username",
		"n": 1
	},
	{
		"src": "WebRunner",
		"msg": "plain",
		"browser": "hook"
	},
	{
		"src": "BROWSER",
		"msg": "Updated placeholder from scripted browser",
		"placeholder": "ph"
	},
	{
		"src": "BROWSER",
		"msg": "All placeholders filled by scripted browser"
	}
]
`;

