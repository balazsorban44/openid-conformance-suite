							"task": "Login",
							"optional": true,
							"match": "${TARGET_URL}/interaction*",
							"commands": [
								["wait", "xpath", "//*", 10, "Sign-in", "update-image-placeholder-optional"],
								["text", "name", "login", "foo", "optional"],
								["text", "name", "password", "bar", "optional"],
								["click", "class", "login-submit"]
							]
						},
						{
