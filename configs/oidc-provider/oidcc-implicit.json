{
	"description": "oidc-provider OIDC (implicit, dynamic client registration)",
	"alias": "oidc-provider",
	"plan": "oidcc-implicit-certification-test-plan",
	"variant": {
		"server_metadata": "discovery",
		"client_registration": "dynamic_client"
	},
	"server": {
		"discoveryUrl": "${TARGET_URL}/.well-known/openid-configuration",
		"code_reuse_delay": 1
	},
	"client": {
		"client_name": "first-openid-client"
	},
	"client2": {
		"client_name": "second-openid-client"
	},
	"browser": [
		{
			"match": "${TARGET_URL}/auth*",
			"tasks": [
				{
					"task": "Login",
					"optional": true,
					"match": "${TARGET_URL}/interaction*",
					"commands": [
						["text", "name", "login", "foo", "optional"],
						["text", "name", "password", "bar", "optional"],
						["click", "class", "login-submit"]
					]
				},
				{
					"task": "Consent",
					"optional": true,
					"match": "${TARGET_URL}/interaction*",
					"commands": [["click", "class", "login-submit"]]
				},
				{
					"task": "Verify Complete",
					"match": "*/test/*/callback*",
					"commands": [["wait", "id", "submission_complete", 10]]
				}
			]
		},
		{
			"match": "${TARGET_URL}/session/end*",
			"tasks": [
				{
					"task": "Choose logout option",
					"match": "${TARGET_URL}/session/end*",
					"commands": [["click", "css", "button[autofocus] "]]
				},
				{
					"task": "process user choice, wait for redirect back",
					"optional": true,
					"match": "${TARGET_URL}/session/end/confirm",
					"commands": [["wait", "match", "/test/.*/post", 10]]
				},
				{
					"task": "Verify Complete",
					"match": "*/test/*/post*"
				}
			]
		}
	],
	"override": {
		"oidcc-prompt-login": {
			"browser": [
				{
					"comment": "updates placeholder during the second authorization",
					"match": "${TARGET_URL}/auth*",
					"tasks": [
