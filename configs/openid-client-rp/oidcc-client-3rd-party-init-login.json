{
	"description": "openid-client RP (3rd party initiated login; the suite's browser visits the RP's https initiate_login_uri)",
	"alias": "openid-client-rp",
	"plan": "oidcc-client-test-3rd-party-init-login-test-plan",
	"variant": {
		"client_auth_type": "client_secret_basic",
		"response_type": "code",
		"response_mode": "default",
		"client_registration": "dynamic_client",
		"request_type": "plain_http_request"
	},
	"browser": [
		{
			"match": "https://localhost:${PORT_HTTPS}/initiate-login*",
			"tasks": [
				{
					"task": "Verify Complete",
					"match": "${TARGET_URL}/cb*",
					"commands": [["wait", "id", "rp-login-complete", 10]]
				}
			]
		}
	],
	"waitTimeoutSeconds": 5,
	"target": {
		"command": "node targets/openid-client-rp/server.ts",
		"url": "http://localhost:${PORT}",
		"readyUrl": "${TARGET_URL}/ready",
		"env": {
			"NODE_EXTRA_CA_CERTS": "configs/certs/localhost.crt",
			"RP_HTTPS_PORT": "${PORT_HTTPS}"
		}
	},
	"client_driver": {
		"startUrl": "${TARGET_URL}/start"
	},
	"expectedFailures": "../expected-failures/openid-client-rp.json",
	"expectedSkips": "../expected-skips/openid-client-rp.json"
}
