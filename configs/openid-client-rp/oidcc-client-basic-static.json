{
	"description": "openid-client RP (basic, static client)",
	"alias": "openid-client-rp",
	"plan": "oidcc-client-basic-certification-test-plan",
	"variant": {
		"client_registration": "static_client",
		"request_type": "plain_http_request"
	},
	"waitTimeoutSeconds": 5,
	"client": {
		"client_id": "openid-client-rp",
		"client_secret": "rp-secret-0123456789abcdefghij",
		"redirect_uri": "${TARGET_URL}/cb"
	},
	"target": {
		"command": "node targets/openid-client-rp/server.ts",
		"url": "http://localhost:${PORT}",
		"readyUrl": "${TARGET_URL}/ready",
		"env": {
			"NODE_EXTRA_CA_CERTS": "configs/certs/localhost.crt",
			"RP_HTTPS_PORT": "${PORT_HTTPS}"
		}
	},
	"client_driver": {
		"startUrl": "${TARGET_URL}/start"
	},
	"expectedFailures": "../expected-failures/openid-client-rp.json",
	"expectedSkips": "../expected-skips/openid-client-rp.json"
}
