{
	"description": "openid-client RP as a plain OAuth 2.0 client (FAPI 2.0 Security Profile, fapi_client_type=plain_oauth: no openid scope, no id_token; private_key_jwt, DPoP, PAR, PKCE; the RP's private key is configs/openid-client-rp/fapi2-rp-keys.json, its public part is client.jwks)",
	"alias": "openid-client-rp",
	"plan": "fapi2-security-profile-final-client-test-plan",
	"variant": {
		"client_auth_type": "private_key_jwt",
