{
	"description": "suite vs suite: OP basic plan against this suite's own emulated OP (oidcc-client-test)",
	"alias": "suite-op-tests",
	"server": {
		"discoveryUrl": "set by the runner from suite_target"
	},
	"client": {
		"client_name": "suite-vs-suite-client"
	},
	"client2": {
		"client_name": "suite-vs-suite-client-2"
	},
	"browser": [
		{
			"match": "*/test/a/emulated-op/authorize*",
			"tasks": [
				{
					"task": "Verify Complete",
					"match": "*/callback*",
					"commands": [["wait", "id", "submission_complete", 10]]
				}
			]
		}
	],
	"suite_target": {
		"module": "oidcc-client-test",
		"alias": "emulated-op",
		"variant": {
			"client_auth_type": "client_secret_basic",
			"response_type": "code",
			"response_mode": "default",
			"request_type": "plain_http_request",
			"client_registration": "dynamic_client"
		},
		"config": {
			"waitTimeoutSeconds": 10
		}
	},
	"expectedFailures": "../expected-failures/suite-vs-suite.json"
}
