{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"printWidth": 120,
	"semi": true,
	"singleQuote": false,
	"trailingComma": "all",
	"ignorePatterns": [
		"node_modules",
		"test-results",
		"playwright-report",
		"conformance-report",
		"ui/sample-data",
		".upstream",
		".next",
		"next-env.d.ts"
	]
}
